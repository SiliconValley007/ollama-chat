{
  "name": "ollama-chat",
  "version": "1.0.0",
  "description": "Self-hosted Ollama chat UI with history",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/ollama-chat-win.exe",
    "build:mac": "pkg . --targets node18-macos-x64 --output dist/ollama-chat-mac",
    "build:linux": "pkg . --targets node18-linux-x64 --output dist/ollama-chat-linux",
    "build:all": "npm run build:win && npm run build:mac && npm run build:linux"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "outputPath": "dist",
    "scripts": ["node_modules/pdf-parse/lib/pdf.js/v1.10.100/build/pdf.js"]
  },
  "overrides": {
    "qs": ">=6.16.0"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.14.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.0"
  }
}
